{
  "name": "mnemo",
  "version": "0.1.0",
  "private": true,
  "description": "Mnemo — AI-powered application",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
