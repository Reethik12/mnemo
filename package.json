    "type-check": "tsc --noEmit",
    "validate": "tsc --noEmit && eslint . && prettier --check .",
    "prepare": "husky",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.5",
    "@ai-sdk/deepseek": "^3.0.3",
    "@ai-sdk/google": "^4.0.5",
    "@ai-sdk/groq": "^4.0.3",
    "@ai-sdk/openai": "^4.0.5",
    "@cognee/cognee-ts": "^0.1.3",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "ai": "^7.0.10",
    "better-auth": "^1.6.23",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.0",
    "next": "16.2.9",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
